# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Audiobookshelf Server URL (ABS_TARGET_SERVER or ABS_SERVER_URL)
# NOTE FOR DOCKER: If Audiobookshelf is running as a Docker container, use your host's LAN IP
# (e.g. http://192.168.68.102:13378) instead of localhost/127.0.0.1 to avoid container port routing failures.
ABS_TARGET_SERVER="http://192.168.68.102:13378"
ABS_SERVER_URL="http://192.168.68.102:13378"

# Path where snippets and markdown transcripts will be saved
SNIPPETS_DIR="/data/snippets"
VOLUME_DIR="/data"

# Host path where audiobooks are stored (used to translate Docker container /audiobooks to host disk)
AUDIOBOOKS_PATH="/srv/ssd/Bookshelf/Audiobooks"
# Optional container:host path mappings (comma-separated)
PATH_MAPPINGS="/audiobooks:/srv/ssd/Bookshelf/Audiobooks,/summaries:/srv/ssd/Bookshelf/Summaries"

# Audio & Clipping Settings
# Default snippet length for manually captured bookmarks from the Web UI (seconds)
SNIPPET_DURATION="60"
SNIPPET_PRE_ROLL="30"

# Admin configuration for bookmarks intercepted from the official mobile apps / web client
INTERCEPT_SNIPPET_DURATION="60"
INTERCEPT_PRE_ROLL="30"

# Port Configuration
# Web Dashboard & Express server port (Default: 13379 in production / PM2; 3000 in AI Studio dev preview)
PORT=13379

# Python Sidecar & Interceptor Proxy port (Default: 13380)
SIDECAR_PORT=13380

# Sidecar URL (Used by the web server to reach the FastAPI sidecar)
# Defaults to http://localhost:13380 (or http://127.0.0.1:13380)
SIDECAR_URL="http://localhost:13380"

# Backend Server Proxy (Default: true)
# Automatically proxies client API calls to bypass browser CORS errors
USE_BACKEND_PROXY="true"

# Performance & Raspberry Pi Resource Optimization
BOOKMARK_SYNC_INTERVAL="120"
PREWARM_WHISPER="false"
WHISPER_THREADS="2"
TOKEN_CACHE_TTL="60"
OMP_NUM_THREADS="2"
OPENBLAS_NUM_THREADS="2"
